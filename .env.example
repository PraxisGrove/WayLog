# ============================================================================
# .env.example — 环境变量模板文件
# ============================================================================
# 本文件列出了项目所需的所有环境变量及其用途说明。
# 使用方式：复制此文件为 .env.local 并填入真实值：
#   cp .env.example .env.local
#
# 注意：
#   - .env.local 已被 .gitignore 忽略，不会提交到版本控制
#   - 以 EXPO_PUBLIC_ 为前缀的变量会暴露到客户端代码中
#   - 不以 EXPO_PUBLIC_ 为前缀的变量仅服务端可用（如 Edge Functions）
#   - 部分变量由 sync-supabase-secrets.js 脚本同步到 Supabase 远程项目
# ============================================================================

# ----------------------------------------------------------------------------
# 高德地图（Amap）配置
# ----------------------------------------------------------------------------

# 高德 Web 端 JS API Key：用于交互地图渲染（高德 Key 设计上是公开的）
# 申请地址：https://lbs.amap.com/api/javascript-api/guide/abc/prepare
EXPO_PUBLIC_AMAP_JS_API_KEY=?

# 高德 JS API 备用 Key（可选，主 Key 配额耗尽时自动切换）
# EXPO_PUBLIC_AMAP_JS_API_KEY_BACKUP=?

# 高德 JS API 安全密钥（服务端配置，通过 Edge Function 运行时下发，避免硬编码到源码）
# AMAP_JS_SECURITY_CODE=?
# AMAP_JS_SECURITY_CODE_BACKUP=?

# ----------------------------------------------------------------------------
# Supabase 配置
# ----------------------------------------------------------------------------

# Supabase 项目 URL：格式为 https://<project-id>.supabase.co
# 用于手机号短信 OTP 登录及数据存储
EXPO_PUBLIC_SUPABASE_URL=?

# 远端维护脚本的目标项目（可选，也可传 [project-ref] 或从项目 URL 推导）
# SUPABASE_PROJECT_REF=?

# Supabase Anon Public Key：客户端匿名访问密钥
# 可在 Supabase Dashboard > Project Settings > API 中找到
EXPO_PUBLIC_SUPABASE_ANON_KEY=?

# ----------------------------------------------------------------------------
# 微信开放平台配置
# ----------------------------------------------------------------------------

# 微信开放平台移动应用 AppID：微信登录审核通过后使用
# 申请地址：https://open.weixin.qq.com/
EXPO_PUBLIC_WECHAT_APP_ID=?

# ----------------------------------------------------------------------------
# Agent 功能开关
# ----------------------------------------------------------------------------

# 内测 APK 默认显示 Agent 入口；设置为 false/0/off/no 可隐藏入口
# EXPO_PUBLIC_AGENT_ENABLED=true

# ----------------------------------------------------------------------------
# 地点图片服务（可选）
# ----------------------------------------------------------------------------

# Unsplash / Pixabay 图片搜索 Key；未配置时图片搜索返回空结果
# 这些 Key 会打包到客户端，请使用自己的 Key 并按服务商要求限制使用范围
# EXPO_PUBLIC_UNSPLASH_ACCESS_KEY=?
# EXPO_PUBLIC_PIXABAY_API_KEY=?

# ----------------------------------------------------------------------------
# 服务端密钥（Supabase Edge Function secrets）
# ----------------------------------------------------------------------------
# 以下密钥仅在服务端使用，不要放入 Expo 客户端环境变量。
# 这些密钥通过 sync-supabase-secrets.js 脚本同步到 Supabase 项目。
#
# 使用方法：
#   1. 在被忽略的 .env.local 中添加对应变量并填入自己的值
#   2. 运行 node scripts/sync-supabase-secrets.js
#   3. 本模板始终只保留变量说明和占位值

# 高德地图 Web 服务 API Key（服务端调用用，如 POI 搜索、路径规划等）
# AMAP_WEB_SERVICE_KEY=?

# 高德地图 Web 服务备用 API Key（可选，主 Key 配额耗尽时自动切换）
# AMAP_WEB_SERVICE_KEY_BACKUP=?

# 微信开放平台 AppSecret：用于微信登录的服务端验证
# WECHAT_APP_SECRET=?

# 阿里云号码认证服务 AccessKey：仅供 Supabase Edge Functions 发送和校验短信验证码
# ALIYUN_ACCESS_KEY_ID=?
# ALIYUN_ACCESS_KEY_SECRET=?

# Supabase Service Role Key：具备绕过 RLS 的最高数据库权限
# 务必保密，仅用于 Edge Functions 等受信任的服务端环境；agent-llm-proxy
# 用它读取私有远程运行配置并写入白名单遥测，不得使用 EXPO_PUBLIC_ 前缀
# SUPABASE_SERVICE_ROLE_KEY=?

# Edge Function Supabase 运行配置：通常由 sync-supabase-secrets.js 从上方客户端配置同步
# 如需覆盖，可显式填写服务端使用的 URL / publishable key
# SUPABASE_URL=?
# SUPABASE_PUBLISHABLE_KEY=?

# 后台服务配置中心密钥加密 Key：仅供 admin-web 服务端使用
# 不要使用 EXPO_PUBLIC_ / NEXT_PUBLIC_ 前缀，也不要暴露给客户端
# ADMIN_SERVICE_CONFIG_ENCRYPTION_KEY=?

# 蒲公英 API Key：用于 pgyer-update-check Edge Function 查询最新内测包信息，也用于本地发布上传
# PGYER_API_KEY=?
# 自有蒲公英应用目标：appKey 或 shortcode，二选一；同时配置时 appKey 优先
# 未配置目标时不查询远端，返回无更新
# PGYER_APP_KEY=?
# PGYER_APP_SHORTCUT=?

# Agent LLM：用于 agent-llm-proxy Edge Function 的 OpenAI-compatible Chat API
# 当前建议 DeepSeek V4 Flash，Base URL 不要带 /chat/completions 后缀。
# AGENT_LLM_PROVIDER=deepseek
# AGENT_LLM_BASE_URL=https://api.deepseek.com
# AGENT_LLM_MODEL=deepseek-v4-flash
# AGENT_LLM_API_KEY=?
# AGENT_LLM_TEMPERATURE=0.3
# AGENT_LLM_MAX_TOKENS=1200

# agent-llm-proxy 的环境级默认限流；admin.agent_runtime_config 可远程收窄
# AGENT_TURN_RATE_LIMIT_PER_MINUTE=6
# AGENT_TURN_RATE_LIMIT_PER_DAY=60
# AGENT_RATE_LIMIT_TIMEOUT_MS=3000

# Web Search：用于 web-search Edge Function 的公开网页搜索代理
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=?
# BRAVE_SEARCH_API_KEY=?

# DeepSeek API Key：用于 generate-place-info Edge Function 生成地点介绍
# DEEPSEEK_API_KEY=?

# Telegram Bot Token：反馈通知推送到 Telegram，从 @BotFather 获取
# TELEGRAM_BOT_TOKEN=?

# Telegram Chat ID：接收反馈通知的用户/群组 ID
# TELEGRAM_CHAT_ID=?

# Telegram 运维 webhook：三个配置同时存在才启用，只接受指定聊天中的管理员。
# 创建 Telegram setWebhook 时，将同一值作为 secret_token；请求须带
# X-Telegram-Bot-Api-Secret-Token。仅保留只读命令，不支持清空反馈。
# TELEGRAM_WEBHOOK_SECRET=?
# TELEGRAM_ADMIN_USER_ID=?

# 反馈通知 / 每日统计的专用服务端 Bearer 凭据，缺少有效凭据时拒绝请求。
# 调用方须发送 Authorization: Bearer <secret>；也兼容已有 service-role Bearer。
# 数据库触发器和 cron 从 Vault 的 waylog_internal_webhook_secret 条目读取同一值。
# INTERNAL_WEBHOOK_SECRET=?

# Sentry webhook 的 HMAC signing secret：缺少时拒绝写入崩溃报告。
# 签名校验原始请求 body；这些 webhook 密钥均不得使用客户端公开前缀。
# SENTRY_WEBHOOK_SECRET=?

# ----------------------------------------------------------------------------
# 本地 Android 发布
# ----------------------------------------------------------------------------

# 正式 Android 签名。凭据只写入 .env.local 或系统环境变量，不要提交真实值。
# KEYSTORE_PATH=/absolute/path/to/release.keystore
# KEYSTORE_PASSWORD=?
# KEY_ALIAS=?
# KEY_PASSWORD=?

# GitHub Personal Access Token：本地未安装 gh CLI 时，用于直传 GitHub Releases API
# 需要对当前仓库具备 Contents 写权限。也可改用 GH_TOKEN。
# GITHUB_TOKEN=?

# 运营联系邮箱（可选、客户端公开）；独立部署时配置自己的支持邮箱
# EXPO_PUBLIC_SUPPORT_EMAIL=?

# 自有安装包下载页（可选、客户端公开）；未配置时打开组织 GitHub Releases
# EXPO_PUBLIC_APP_DOWNLOAD_URL=https://example.com/download
