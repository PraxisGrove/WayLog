# Local admin-web reads ../.env.local automatically.
# You only need this file when running admin-web outside the monorepo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Keep this out of browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used to encrypt service provider secrets at rest.
# Do not prefix this with NEXT_PUBLIC_.
ADMIN_SERVICE_CONFIG_ENCRYPTION_KEY=
