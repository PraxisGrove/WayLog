{
  "name": "waylog",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm start:expo",
    "dev:sync": "pnpm secrets:sync && pnpm dev",
    "auth:email:sync": "node scripts/sync-supabase-auth-email-templates.js",
    "secrets:sync": "node scripts/sync-supabase-secrets.js",
    "start:expo": "expo start",
    "start": "pnpm dev",
    "admin:dev": "pnpm --filter @waylog/admin-web dev",
    "admin:build": "pnpm --filter @waylog/admin-web build",
    "admin:lint": "pnpm --filter @waylog/admin-web lint",
    "admin:typecheck": "pnpm --filter @waylog/admin-web typecheck",
    "preview": "pnpm start:expo --host lan",
    "preview:sync": "pnpm secrets:sync && pnpm preview",
    "build": "expo export",
    "build:sync": "pnpm secrets:sync && pnpm build",
    "build:web": "expo export --platform web",
    "build:web:sync": "pnpm secrets:sync && pnpm build:web",
    "build:prepare": "pnpm typecheck && pnpm test",
    "build:prepare:sync": "pnpm secrets:sync && pnpm build:prepare",
    "android": "pnpm start:expo --android",
    "android:sync": "pnpm secrets:sync && pnpm android",
    "android:release": "node scripts/release-android.js --pgyer --github",
    "ios": "pnpm start:expo --ios",
    "ios:sync": "pnpm secrets:sync && pnpm ios",
    "web": "pnpm start:expo --web",
    "web:sync": "pnpm secrets:sync && pnpm web",
    "apk": "node scripts/release-android.js",
    "release": "node scripts/release-android.js --pgyer --github",
    "release:android": "node scripts/release-android.js --pgyer --github",
    "debug": "node scripts/debug-android.js",
    "agent:pi-compat": "node scripts/verify-pi-react-native.mjs",
    "agent:pi-native:android": "expo run:android --variant release",
    "agent:pi-native:ios": "expo run:ios --configuration Release",
    "agent:pi-compat:android": "expo export:embed --entry-file scripts/fixtures/pi-agent-core-expo-entry.js --platform android --dev false --bundle-output .tmp/pi-compat/android/index.android.bundle --assets-dest .tmp/pi-compat/android/assets",
    "agent:pi-compat:ios": "expo export:embed --entry-file scripts/fixtures/pi-agent-core-expo-entry.js --platform ios --dev false --bundle-output .tmp/pi-compat/ios/main.jsbundle --assets-dest .tmp/pi-compat/ios/assets",
    "agent:route-eval": "node scripts/eval-agent-route-selector.js",
    "agent:trip-draft-eval": "tsc -p tsconfig.test.json && node scripts/eval-agent-trip-draft.js",
    "agent:ui-regression": "node scripts/agent-ui-regression.js",
    "agent:ui-regression:run": "node scripts/agent-ui-regression.js --run",
    "test:agent-ui": "node scripts/agent-ui-regression.js --run --headless",
    "test": "node -e \"require('node:fs').rmSync('.tmp-test-dist', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node scripts/run-tests.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@noble/hashes": "1.8.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "^8.16.0",
    "@supabase/supabase-js": "^2.107.0",
    "expo": "~54.0.35",
    "expo-apple-authentication": "^56.0.4",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-mail-composer": "~15.0.8",
    "expo-modules-core": "~3.0.30",
    "expo-navigation-bar": "~5.0.10",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-wechat-lib": "^1.1.27",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^25.6.2",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "54.0.11",
    "playwright": "^1.61.1",
    "supabase": "^2.109.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
