+// Adapted from @earendil-works/pi-ai EventStream by Mario Zechner.
+// Copyright (c) 2025 Mario Zechner. MIT licensed; see licenses/PI-MIT.txt in WayLog.
+// Hermes 96 cannot execute the upstream async-generator implementation.
+export class EventStream {
+  constructor(isComplete, extractResult) {
+    this.queue = [];
+    this.waiting = [];
+    this.done = false;
+    this.isComplete = isComplete;
+    this.extractResult = extractResult;
+    this.finalResultPromise = new Promise((resolve) => {
+      this.resolveFinalResult = resolve;
+    });
+  }
+
+  push(event) {
+    if (this.done) return;
+    if (this.isComplete(event)) {
+      this.done = true;
+      this.resolveFinalResult(this.extractResult(event));
+    }
+    const waiter = this.waiting.shift();
+    if (waiter) {
+      waiter({ done: false, value: event });
+    } else {
+      this.queue.push(event);
+    }
+  }
+
+  end(result) {
+    this.done = true;
+    if (result !== undefined) this.resolveFinalResult(result);
+    while (this.waiting.length > 0) {
+      this.waiting.shift()({ done: true, value: undefined });
+    }
+  }
+
+  next() {
+    if (this.queue.length > 0) {
+      return Promise.resolve({ done: false, value: this.queue.shift() });
+    }
+    if (this.done) {
+      return Promise.resolve({ done: true, value: undefined });
+    }
+    return new Promise((resolve) => this.waiting.push(resolve));
+  }
+
+  [Symbol.asyncIterator]() {
+    return this;
+  }
+
+  result() {
+    return this.finalResultPromise;
+  }
+}
